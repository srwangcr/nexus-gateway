# Puerto en el que correrá el gateway en el host
GATEWAY_PORT=3000

# Timeout de requests en milisegundos (default: 30000)
GATEWAY_TIMEOUT=30000

# Número de reintentos para requests fallidos (default: 3)
GATEWAY_RETRIES=3

# Secreto para firmar los JSON Web Tokens
JWT_SECRET=un-secreto-muy-seguro-y-largo-para-produccion

# Host de Redis (default: localhost)
REDIS_HOST=localhost

# Puerto de Redis (default: 6379)
REDIS_PORT=6379

# Contraseña para Redis (dejar en blanco si no se usa)
REDIS_PASSWORD=

# Rate limiting: fail open (true) o fail closed (false) si Redis no está disponible
RATE_LIMIT_FAIL_OPEN=true